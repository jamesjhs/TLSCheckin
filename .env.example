# TLSCheckin configuration
PORT=9110
DB_PATH=./data/tlscheckin.db
DB_ENCRYPTION_KEY=change-this-to-a-long-random-database-key
SESSION_SECRET=change-this-to-a-long-random-session-secret
ADMIN_INITIAL_PASSWORD=change-this-in-production

# Cloudflare Turnstile. Leave both blank to disable Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
