# TLSCheckin configuration
PORT=9110
DB_PATH=./data/tlscheckin.db
DB_ENCRYPTION_KEY=change-this-to-a-long-random-database-key
SESSION_SECRET=change-this-to-a-long-random-session-secret
ADMIN_INITIAL_PASSWORD=change-this-in-production

# Cloudflare Turnstile existing widget.
# The site key is public. The secret must be retrieved/stored through Cloudflare's
# normal secret handling and must never be pasted into chat or browser code.
TURNSTILE_SITE_KEY=0x4AAAAAAE2-TTENBA11-lab
TURNSTILE_SECRET=

# Comma-separated hostnames allowed in Cloudflare siteverify responses.
# Production values must not include localhost or 127.0.0.1.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
